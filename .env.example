# ─────────────────────────────────────────────────────────────────────────────
# NJMS — Environment Variable Contract (.env.example per Doc 14 §4)
# ─────────────────────────────────────────────────────────────────────────────

# ---- Runtime ----
NODE_ENV=production
PORT=3000
TZ=Asia/Kolkata
APP_URL=https://your-domain.com
APP_BASE_URL=https://your-domain.com

# ---- Database ----
# Format: mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DBNAME?connection_limit=5&pool_timeout=20&connect_timeout=15
# Password special characters (@ : / ? # % & + ^ $) MUST be URL-encoded (e.g. / -> %2F, ^ -> %5E, $ -> %24)
DATABASE_URL=mysql://u148306822_admin:%2FYREd%5ExERMb_%24q8@srv2209.hstgr.io:3306/u148306822_njms?connection_limit=5&pool_timeout=20&connect_timeout=15

# ---- Auth and Security ----
# 32+ random characters; generate with: openssl rand -base64 32
AUTH_SECRET=your-32-char-random-auth-secret-string
PIN_PEPPER=your-random-pin-pepper-secret-string
HEALTH_TOKEN=your-random-health-token-for-api-health-db
CRON_SECRET=your-random-cron-secret-for-scheduled-tasks

# ---- Files ----
# Absolute path outside the deployed app folder that persists across redeploys
UPLOAD_DIR=/home/u148306822/njms/uploads
MAX_UPLOAD_MB=8

# ---- Optional ----
LOG_LEVEL=info
BACKUP_DIR=/home/u148306822/njms/backups
COOKIE_SECURE=true
